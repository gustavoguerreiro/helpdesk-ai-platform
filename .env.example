# Copy this file to .env and adjust. Never commit real secrets.

# Direct connection to Postgres (used for migrations and the SQL lab).
# If port 5432 is taken, set POSTGRES_PORT=5433 below and use 5433 here.
DATABASE_DIRECT_URL=postgresql://helpdesk:helpdesk_dev_password@localhost:5432/helpdesk

# Connection through PgBouncer (used by the app at runtime).
# "pgbouncer=true" tells Prisma not to use prepared statements,
# which do not work in PgBouncer's transaction mode.
DATABASE_URL=postgresql://helpdesk:helpdesk_dev_password@localhost:6432/helpdesk?pgbouncer=true

# Anthropic API key, only needed to run the agent against a real model.
# The tests use a fake model and do not need it.
ANTHROPIC_API_KEY=

# Optional: host ports for docker compose (defaults: 5432 and 6432).
# POSTGRES_PORT=5433
# PGBOUNCER_PORT=6432
